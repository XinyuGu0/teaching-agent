# Local development
FLASK_ENV=development
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000
SECRET_KEY=replace-with-a-random-local-secret
JWT_SECRET_KEY=replace-with-another-random-secret
DATABASE_URL=sqlite:///guowaibao.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REDIS_URL=redis://localhost:6379/0
UPLOAD_MAX_SIZE=104857600
ALLOWED_EXTENSIONS=pdf,doc,docx,ppt,pptx,xls,xlsx,txt,md,jpg,jpeg,png,gif,mp4,avi,mov,mp3,wav,m4a,ogg,flac,aac

# Configure an OpenAI-compatible provider and supported model
LLM_API_KEY=
LLM_BASE_URL=https://api.bltcy.cn/v1
LLM_MODEL=qwen3.5-plus-2026-02-15
GLM_API_KEY=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3
VISION_API_KEY=
VISION_API_URL=https://api.bltcy.cn/v1/chat/completions
VISION_MODEL=qwen3-vl-235b-a22b
IMAGE_GEN_API_KEY=
IMAGE_GEN_API_URL=https://api.bltcy.cn/v1/images/generations
IMAGE_GEN_MODEL=qwen-image
IMAGE_GEN_TIMEOUT=180
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://api.gpt-best.com/v1
DOUBAO_IMAGE_MODEL=doubao-seedance-1-5-pro-251215
DOUBAO_ASYNC_TIMEOUT_SECONDS=75
DOUBAO_ASYNC_POLL_INTERVAL_SECONDS=2.5
DOCMEE_API_KEY=
DOCMEE_BASE_URL=https://api.bltcy.cn
DOCMEE_TIMEOUT_SECONDS=60
DOCMEE_POLL_INTERVAL_SECONDS=5
DOCMEE_PPT_MODEL_ID=docmee-ppt-generate
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# Optional separately installed document editors
ONLYOFFICE_URL=http://localhost:80
ONLYOFFICE_JWT_SECRET=
PUBLIC_BASE_URL=
WOPI_BASE_URL=http://127.0.0.1:9980
WOPI_HOST=http://127.0.0.1:5000
WOPI_SECRET_KEY=replace-with-a-random-wopi-secret
WOPI_TOKEN_TTL=3600
